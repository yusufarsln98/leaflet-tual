{
  "name": "leaflet-tual-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/leaflet-tual",
    "apps/homepage"
  ],
  "scripts": {
    "build": "npm run build:lib && npm run build:homepage",
    "dev:lib": "npm run dev --workspace=leaflet-tual",
    "dev:homepage": "npm run dev --workspace=homepage",
    "preview:homepage": "npm run preview --workspace=homepage",
    "build:lib": "npm run build --workspace=leaflet-tual",
    "build:homepage": "npm run build --workspace=homepage",
    "lint:lib": "npm run lint --workspace=leaflet-tual",
    "test": "npm run test --workspace=leaflet-tual",
    "test:lib": "npm run test --workspace=leaflet-tual",
    "changeset": "changeset",
    "typecheck:lib": "npm run typecheck --workspace=leaflet-tual",
    "typecheck": "npm run typecheck:lib"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "tsup": "^8.5.1"
  }
}
